---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { projects, type Project } from "../../data/projects";
import { orangeRevision, tryCommands } from "../../data/orange-sources";
export function getStaticPaths() {
  return projects.map((project) => ({
    params: { slug: project.slug },
    props: { project },
  }));
}
interface Props {
  project: Project;
}
const { project } = Astro.props;
const isOrange = project.slug === "orange";
if (isOrange && !project.sources.some((source) => source.href.includes(orangeRevision))) {
  throw new Error("Orange sources must be pinned to the checked orange main revision.");
}
---

<BaseLayout title={project.name} description={project.summary}>
  <main
    id="main"
    class="project-page shell"
  >
    <nav class="breadcrumbs" aria-label="Breadcrumb">
      <a href="/">No Such Machine</a>
      <span aria-hidden="true">/</span>
      <span aria-current="page">{project.name}</span>
    </nav>
    <header class="project-header">
      <div>
        <h1>{project.name}</h1>
        <p class="project-tagline">{project.summary}</p>
        <div class="hero-actions">
          <a class="button button-primary" href={project.githubUrl}>
            View repository
          </a>
          <a class="text-link" href="#overview">
            Read the project
          </a>
        </div>
      </div>
      {isOrange && (
        <div class="project-art">
          <img src="/projects/orange/emblem.svg" alt="" width="1024" height="1024" />
        </div>
      )}
    </header>
    <dl class="project-facts">
      <div>
        <dt>Current state</dt>
        <dd>{project.status}</dd>
      </div>
      <div>
        <dt>Discipline</dt>
        <dd>{project.categories.join(" · ")}</dd>
      </div>
      <div>
        <dt>Built with</dt>
        <dd>{project.technologies.join(" / ")}</dd>
      </div>
    </dl>
    <div class="project-body">
      <nav class="project-toc" aria-label="On this page">
        <span>IN THIS PROJECT</span>
        <a href="#overview">Overview</a>
        <a href="#approach">How it works</a>
        <a href="#capabilities">What’s implemented</a>
        {isOrange ? (
          <>
            <a href="#non-claims">Non-claims</a>
            <a href="#try">How to try it</a>
          </>
        ) : (
          <a href="#status">Current state</a>
        )}
        <a href="#resources">Source & resources</a>
      </nav>
      <div class="project-prose">
        <section id="overview" aria-labelledby="overview-title">
          <h2 id="overview-title">The idea</h2>
          <p>{project.purpose}</p>
        </section>
        <section id="approach" aria-labelledby="approach-title">
          <h2 id="approach-title">How it works</h2>
          <p>{project.approach}</p>
        </section>
        <section id="capabilities" aria-labelledby="capabilities-title">
          <h2 id="capabilities-title">What’s implemented</h2>
          <ul>
            {project.capabilities.map((capability) => (
              <li>{capability}</li>
            ))}
          </ul>
        </section>
        {isOrange ? (
          <section id="non-claims" class="note" aria-labelledby="non-claims-title">
            <h2 id="non-claims-title">Where it stands</h2>
            <p>{project.maturity}</p>
            {project.limitations.length > 0 && (
              <ul>
                {project.limitations.map((limit) => (
                  <li>{limit}</li>
                ))}
              </ul>
            )}
          </section>
        ) : (
          <section
            id="status"
            class="project-status-box"
            aria-labelledby="status-title"
          >
            <h2 id="status-title">Where it stands</h2>
            <p>{project.maturity}</p>
            {project.limitations.length > 0 && (
              <ul>
                {project.limitations.map((limit) => (
                  <li>{limit}</li>
                ))}
              </ul>
            )}
          </section>
        )}
        {isOrange && (
          <section id="try" aria-labelledby="try-title">
            <h2 id="try-title">How to try it</h2>
            <p>These commands are copied from the Orange README. Rust 1.96.1 is pinned in rust-toolchain.toml. The compiler has no third-party dependencies. The repository gate runs on Linux 6.2 or newer.</p>
            <pre class="shell-listing" tabindex="0" aria-label="Orange README quick start commands"><code>{tryCommands}</code></pre>
            <p>S0 through S2 are done. S3 is in progress. S4 through S8 and 1.0 are open. orangec --version reports implemented slice S3u. Three of ten gates are closed, counting finished stages, not time.</p>
            <p class="try-roadmap">
              <a class="text-link link-external" href={`https://github.com/nightwarelabz/orange/blob/${orangeRevision}/docs/ROADMAP.md`} rel="noopener noreferrer">Roadmap <span class="external-icon" aria-hidden="true">↗</span></a>
            </p>
          </section>
        )}
        <section id="resources" aria-labelledby="resources-title">
          <h2 id="resources-title">Source & resources</h2>
          <div class="resource-list">
            <a href={project.githubUrl}>
              <strong>GitHub repository</strong>
              <span>Source code and project documentation ↗</span>
            </a>
            {project.links
              .filter((link) => link.href !== project.githubUrl)
              .map((link) => (
                <a href={isOrange && link.label === "Orange Book" ? "/book/" : link.href}>
                  <strong>{link.label}</strong>
                  <span>{isOrange && link.label === "Orange Book" ? "Read on this site →" : "Open resource ↗"}</span>
                </a>
              ))}
          </div>
          {project.sources.length > 0 && (
            <details class="source-details">
              <summary>Documentation behind this project page</summary>
              <ul>
                {project.sources.map((source) => (
                  <li>
                    <a href={source.href}>{source.label}</a>
                  </li>
                ))}
              </ul>
              <p>
                {isOrange
                  ? `Checked 9 October 2026 against orange main ${orangeRevision}. Compiler tests were not re-run.`
                  : "Reviewed October 1, 2026. Project descriptions reflect a source review; repository validation claims were not independently reproduced."}
              </p>
            </details>
          )}
        </section>
      </div>
    </div>
    <div class="project-end">
      <a class="text-link" href={isOrange ? "/" : "/projects/orange/"}>
        {isOrange ? "Return home" : "Explore Orange"}
      </a>
    </div>
  </main>
</BaseLayout>
