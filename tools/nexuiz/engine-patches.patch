+#endif // USE_GLES2
 
 #define BACKENDACTIVECHECK if (!gl_state.active) Sys_Error("GL backend function called when backend is not active");
 
@@ -968,6 +970,15 @@ int R_Mesh_CreateFramebufferObject(rtexture_t *depthtexture, rtexture_t *colorte
 		CHECKGLERROR
 		qglGenFramebuffers(1, (GLuint*)&temp);CHECKGLERROR
 
+#ifdef USE_GLES2
+		// The desktop path binds the new framebuffer through
+		// R_Mesh_SetRenderTargets, which this flavor excludes;
+		// without a bind the attachments below land on whatever
+		// framebuffer was bound before, the new one stays empty
+		// (incomplete), and every rendertarget renders black.
+		qglBindFramebuffer(GL_FRAMEBUFFER, temp);CHECKGLERROR
+#endif
+
 #ifndef USE_GLES2
 		R_Mesh_SetRenderTargets(temp);  // This breaks GLES2.
 		// GL_ARB_framebuffer_object (GL3-class hardware) - depth stencil attachment
@@ -1034,6 +1045,7 @@ int R_Mesh_CreateFramebufferObject(rtexture_t *depthtexture, rtexture_t *colorte
 			qglDeleteFramebuffers(1, (GLuint*)&temp);CHECKGLERROR
 			temp = 0;
 		}
+		qglBindFramebuffer(GL_FRAMEBUFFER, gl_state.framebufferobject ? gl_state.framebufferobject : gl_state.defaultframebufferobject);CHECKGLERROR
 		return temp;
 	}
 	return 0;
@@ -1097,6 +1109,7 @@ static void GL_Backend_ResetState(void)
 	case RENDERPATH_GL32:
 	case RENDERPATH_GLES2:
 		// set up debug output early
+#ifndef USE_GLES2
 		if (gl_debug.integer > 0 && vid.support.arb_debug_output)
 		{
 			GLuint unused = 0;
@@ -1116,6 +1129,7 @@ static void GL_Backend_ResetState(void)
 				qglDebugMessageControlARB(GL_DONT_CARE, GL_DONT_CARE, GL_DONT_CARE, 0, &unused, GL_FALSE);
 			qglDebugMessageCallbackARB(GL_DebugOutputCallback, NULL);
 		}
+#endif // USE_GLES2
 		CHECKGLERROR
 		qglColorMask(1, 1, 1, 1);CHECKGLERROR
 		qglBlendFunc(gl_state.blendfunc1, gl_state.blendfunc2);CHECKGLERROR
