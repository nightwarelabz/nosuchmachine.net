/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Cross-Origin-Opener-Policy: same-origin
  X-Permitted-Cross-Domain-Policies: none
  Origin-Agent-Cluster: ?1
  Permissions-Policy: camera=(), microphone=(), geolocation=(), bluetooth=(self)
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Cache-Control: public, max-age=0, must-revalidate, no-transform
  Content-Security-Policy: default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; script-src 'self'; object-src 'none'; base-uri 'self'; form-action 'none'; frame-ancestors 'none'; upgrade-insecure-requests
  ! NEL
  ! Report-To

/_astro/*
  ! Cache-Control
  Cache-Control: public, max-age=31536000, immutable

/api/*
  ! Cache-Control
  Cache-Control: no-store

# The live-update stamp: never cached, or no client would ever see a
# newer build named in it.
/version.json
  Cache-Control: no-store

# BLACKSITE OS is a machine for running the visitor's own programs in
# their own browser (Skulpt Python, the JS engine room). That is eval by
# design — scoped to the OS subtree only; every other page keeps the
# strict policy above.
/
  ! Content-Security-Policy
  Content-Security-Policy: default-src 'self'; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; font-src 'self'; script-src 'self' 'unsafe-eval' 'wasm-unsafe-eval'; worker-src 'self' blob:; connect-src 'self' wss:; frame-src 'self' https:; object-src 'none'; base-uri 'self'; form-action 'none'; frame-ancestors 'self'; upgrade-insecure-requests
  ! X-Frame-Options
  X-Frame-Options: SAMEORIGIN
  Cross-Origin-Embedder-Policy: require-corp

/blacksite/*
  ! Content-Security-Policy
  Content-Security-Policy: default-src 'self'; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; font-src 'self'; script-src 'self' 'unsafe-eval' 'wasm-unsafe-eval'; worker-src 'self' blob:; connect-src 'self' wss:; frame-src 'self' https:; object-src 'none'; base-uri 'self'; form-action 'none'; frame-ancestors 'self'; upgrade-insecure-requests
  ! X-Frame-Options
  X-Frame-Options: SAMEORIGIN
  Cross-Origin-Embedder-Policy: require-corp

# phantom: the worker and the wasm binary it hosts. Same
# relaxations as the OS scope it serves, plus the embedder policy the
# SharedArrayBuffer stdin ring requires.
/phantom/*
  ! Content-Security-Policy
  Content-Security-Policy: default-src 'self'; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; font-src 'self'; script-src 'self' 'unsafe-eval' 'wasm-unsafe-eval'; worker-src 'self' blob:; connect-src 'self' wss:; object-src 'none'; base-uri 'self'; form-action 'none'; frame-ancestors 'none'; upgrade-insecure-requests
  Cross-Origin-Embedder-Policy: require-corp

# tv: the broadcast player frame. The OS page's policy admits no
# blob: media — media-src falls back to default-src 'self' there,
# and a MediaSource load is a blob: load, which Chromium refuses
# under that word. So the player is a document of its own, on the
# nexuiz play-frame precedent: the OS policy is not loosened by a
# syllable, and this subtree's policy is scoped to exactly what a
# player needs — its engine script, the same-origin relay, blob
# media — framed by the house's own pages only; and it carries the
# embedder policy, without which the OS page's own require-corp
# refuses the frame outright (the same law the ruby section
# records for its worker). The catalog and
# the engine ride the same section; neither is a document and the
# policy is inert on them.
/tv/*
  ! Content-Security-Policy
  Content-Security-Policy: default-src 'none'; script-src 'self'; connect-src 'self'; media-src 'self' blob:; style-src 'unsafe-inline'; img-src 'self' data:; base-uri 'none'; form-action 'none'; frame-ancestors 'self'
  ! X-Frame-Options
  X-Frame-Options: SAMEORIGIN
  Cross-Origin-Embedder-Policy: require-corp

# ruby: the CRuby worker and the interpreter wasm it hosts. The
# worker is spawned from the OS scope, so its script must carry the
# embedder policy itself (require-corp refuses a worker whose
# response does not), and the subtree needs wasm evaluation like
# every other engine subtree.
/ruby/*
  ! Content-Security-Policy
  Content-Security-Policy: default-src 'self'; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; font-src 'self'; script-src 'self' 'unsafe-eval' 'wasm-unsafe-eval'; worker-src 'self' blob:; connect-src 'self' wss:; object-src 'none'; base-uri 'self'; form-action 'none'; frame-ancestors 'none'; upgrade-insecure-requests
  Cross-Origin-Embedder-Policy: require-corp

# wolf3d: the js-dos player and the DOSBox wasm it hosts. The worker
# that runs the machine is served from this subtree, so it needs the
# same wasm-unsafe-eval + embedder policy as the OS scope it serves —
# without the removal line below, the strict catch-all policy above
# would ride along and WebAssembly compilation would stay forbidden.
/wolf3d/*
  ! Content-Security-Policy
  Content-Security-Policy: default-src 'self'; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; font-src 'self'; script-src 'self' 'unsafe-eval' 'wasm-unsafe-eval'; worker-src 'self' blob:; connect-src 'self' wss:; object-src 'none'; base-uri 'self'; form-action 'none'; frame-ancestors 'none'; upgrade-insecure-requests
  Cross-Origin-Embedder-Policy: require-corp

# nexuiz: the DarkPlaces wasm build and its play frame. Same story as
# wolf3d — the engine subtree needs wasm evaluation and the embedder
# policy; play.html also fetches the game data from the site's own
# data pipe, which 'self' already covers.
/nexuiz/*
  ! Content-Security-Policy
  Content-Security-Policy: default-src 'self'; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; font-src 'self'; script-src 'self' 'unsafe-eval' 'wasm-unsafe-eval'; worker-src 'self' blob:; connect-src 'self' wss:; object-src 'none'; base-uri 'self'; form-action 'none'; frame-ancestors 'self'; upgrade-insecure-requests
  Cross-Origin-Embedder-Policy: require-corp

# The engine binaries are the heavy static files of the subtree, and
# they only change when the engine is rebuilt. play.js stamps their
# URLs with its NX_ENGINE_STAMP (the glue via its script URL, the
# wasm via Module.locateFile), so an immutable year is safe: a
# rebuilt engine wears a new stamp and is fetched fresh, and a
# returning player's copies are served from disk with no
# revalidation round-trip. Everything else in the subtree (the play
# page, its script, the autoexec) keeps the revalidate-always rule
# above — small files, and they are how the house ships changes.
/nexuiz/darkplaces-wasm.js
  ! Cache-Control
  Cache-Control: public, max-age=31536000, immutable

/nexuiz/darkplaces-wasm.wasm
  ! Cache-Control
  Cache-Control: public, max-age=31536000, immutable
